{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build && mkdir -p public",
  "outputDirectory": "public",
  "installCommand": "npm install",
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/**",
      "maxDuration": 30
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
