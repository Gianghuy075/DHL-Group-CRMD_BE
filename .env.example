# App
PORT=4567
NODE_ENV=development

# Database (Supabase Postgres)
DB_TYPE=postgres
# Runtime: use the Transaction Pooler (PgBouncer, port 6543).
# Migrations: use a direct/session connection (port 5432) instead — the
# transaction pooler does NOT support migration/DDL sessions.
DB_HOST=aws-1-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_USERNAME=postgres.your_project_ref
DB_PASSWORD=your_db_password
DB_DATABASE=postgres
DB_SCHEMA=DHL-Group-CRM
DB_SSL=true

# Keep false on a shared Supabase DB. synchronize=true lets TypeORM ALTER/DROP
# columns to match entities and can destroy existing data. Use migrations instead.
DB_SYNCHRONIZE=false

# Supabase Auth — BE verifies ES256 access tokens locally via the project JWKS.
SUPABASE_URL=https://your_project_ref.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated

# PayOS (server-side). The checksum key must NEVER be exposed to the frontend.
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
PAYOS_API_ENDPOINT=https://api-merchant.payos.vn/v2

# Facebook Graph API — App Secret stays here on the backend only.
# The frontend uses the public App ID (config.local.js → facebook.appId).
FB_APP_ID=
FB_APP_SECRET=
FB_GRAPH_VERSION=v19.0
